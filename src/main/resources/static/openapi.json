{
  "openapi": "3.1.0",
  "info": {
    "title": "Swift to Java Conversion Guide API",
    "version": "1.0.0",
    "description": "Curated, deterministic Swift → Java 21 mappings for AI agents and developers. No auth. Start with POST /api/analyze for Swift source, or GET /api/search for a single idiom. Guidance for agents: {{BASE_URL}}/llms.txt"
  },
  "servers": [
    {
      "url": "{{BASE_URL}}"
    }
  ],
  "paths": {
    "/api/analyze": {
      "post": {
        "operationId": "analyzeSwift",
        "summary": "Detect Swift constructs in source code and return the matching Java mappings",
        "description": "Pattern-based detection (may include false positives). Findings are ordered by risk (high first), then by line. Max body 200 KB.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `md` for a Markdown response that can be pasted into an LLM context.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              },
              "example": "guard let user = user else { return }\nlet name = user.name ?? \"Unknown\""
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Problem details with a `hint` explaining how to fix the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Problem details with a `hint` explaining how to fix the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "operationId": "searchMappings",
        "summary": "Ranked search by concept or raw Swift syntax",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Concept or Swift syntax, e.g. `guard let`, `??`, `$0`, `inout`, `default parameters`.",
            "example": "guard let"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 5
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `md` for a Markdown response that can be pasted into an LLM context.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SearchHit"
                      }
                    },
                    "hint": {
                      "type": "string"
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Problem details with a `hint` explaining how to fix the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/mappings": {
      "get": {
        "operationId": "listMappings",
        "summary": "List and filter mappings",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Category id from /api/categories."
          },
          {
            "name": "risk",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Tag, e.g. optionals, equality, generics."
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `md` for a Markdown response that can be pasted into an LLM context.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "mappings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Mapping"
                      }
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Problem details with a `hint` explaining how to fix the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/mappings/{id}": {
      "get": {
        "operationId": "getMapping",
        "summary": "One mapping with examples, pitfalls and related mappings",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "optional-binding"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `md` for a Markdown response that can be pasted into an LLM context.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mapping"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id. The body includes `suggestions`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "Categories with mapping counts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/categories/{id}": {
      "get": {
        "operationId": "getCategory",
        "summary": "One category with its mappings",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "strings"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `md` for a Markdown response that can be pasted into an LLM context.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Problem details with a `hint` explaining how to fix the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/checklist": {
      "get": {
        "operationId": "getChecklist",
        "summary": "Final review checklist for a Swift → Java port",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `md` for a Markdown response that can be pasted into an LLM context.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "checklist": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ChecklistItem"
                      }
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/guide": {
      "get": {
        "operationId": "getGuide",
        "summary": "The whole dataset in one response",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Mapping": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "swift",
          "java",
          "summary",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "swift": {
            "type": "string",
            "description": "The Swift construct"
          },
          "java": {
            "type": "string",
            "description": "The Java equivalent"
          },
          "summary": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "detect": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Regexes used by /api/analyze"
          },
          "swiftExample": {
            "type": "string"
          },
          "javaExample": {
            "type": "string"
          },
          "gotchas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "since": {
            "type": "string",
            "description": "Minimum Java version when above the baseline"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "swift": {
            "type": "string"
          },
          "java": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "detailUrl": {
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "mappingCount": {
            "type": "integer"
          }
        }
      },
      "ChecklistItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "mappingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "linesAnalyzed": {
                "type": "integer"
              },
              "constructsFound": {
                "type": "integer"
              },
              "byRisk": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mappingId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "risk": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "swift": {
                  "type": "string"
                },
                "java": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "gotchas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "occurrences": {
                  "type": "integer"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "line": {
                        "type": "integer"
                      },
                      "code": {
                        "type": "string"
                      }
                    }
                  }
                },
                "detailUrl": {
                  "type": "string"
                }
              }
            }
          },
          "checklist": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItem"
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "hint": {
            "type": "string",
            "description": "How to fix the request"
          },
          "example": {
            "type": "string",
            "description": "A valid example request"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
